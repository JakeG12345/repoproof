{
  "name": "repoproof",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.19.0",
    "npm": ">=10.2.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "echo \"Drizzle Kit is intentionally not installed in this MVP because npm audit flags its current transitive esbuild dependency. Keep db/schema.ts and db/migrations/*.sql in sync manually.\"",
    "db:migrate": "psql \"$DATABASE_URL\" -f db/migrations/0001_initial.sql",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@octokit/auth-app": "^8.3.0",
    "@octokit/rest": "^22.0.1",
    "@supabase/supabase-js": "^2.112.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.28.0",
    "nanoid": "^6.0.1",
    "next": "16.3.0",
    "openai": "^7.4.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.18.1",
    "server-only": "^0.0.1",
    "stripe": "^22.4.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
